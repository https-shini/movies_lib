# Chave da API v3 do TMDB (obrigatória).
# Obtenha em https://www.themoviedb.org/settings/api
# Atenção: variáveis VITE_ são incorporadas ao bundle e ficam visíveis no navegador.
VITE_API_KEY=YOUR_TMDB_API_KEY

# Endereços opcionais. Se omitidos, a aplicação usa os endereços públicos do TMDB.
# VITE_API=https://api.themoviedb.org/3/movie/
# VITE_SEARCH=https://api.themoviedb.org/3/search/movie
# VITE_DISCOVER=https://api.themoviedb.org/3/discover/movie
# VITE_GENRES=https://api.themoviedb.org/3/genre/movie/list
# VITE_IMG=https://image.tmdb.org/t/p/w500
# VITE_BACKDROP=https://image.tmdb.org/t/p/w1280
